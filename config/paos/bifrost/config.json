{
  "$schema": "https://www.getbifrost.ai/schema",
  "source_of_truth": "config.json",
  "client": {
    "enforce_auth_on_inference": true,
    "enable_logging": true,
    "disable_content_logging": true,
    "log_retention_days": 30
  },
  "providers": {
    "zen": {
      "keys": [
        {
          "name": "zen-primary",
          "value": "env.ZEN_API_KEY",
          "models": ["research"],
          "weight": 1.0,
          "aliases": { "research": "minimax-m2.7" }
        }
      ],
      "network_config": {
        "base_url": "https://opencode.ai/zen",
        "default_request_timeout_in_seconds": 120,
        "max_retries": 0,
        "stream_idle_timeout_in_seconds": 60
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "chat_completion": true,
          "chat_completion_stream": true
        },
        "request_path_overrides": { "chat_completion": "/v1/chat/completions", "chat_completion_stream": "/v1/chat/completions" }
      }
    }
  },
  "governance": {
    "auth_config": {
      "is_enabled": true,
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD",
      "disable_auth_on_inference": false
    },
    "virtual_keys": [
      {
        "id": "vk-paos-worker",
        "name": "paos-worker",
        "value": "env.PAOS_WORKER_VK",
        "is_active": true,
        "allow_all_providers": false,
        "provider_configs": [
          { "provider": "zen", "allowed_models": ["research"], "key_ids": ["*"], "weight": 1 }
        ]
      }
    ],
    "budgets": [
      { "id": "budget-paos-worker-monthly", "max_limit": 20.0, "reset_duration": "1M", "virtual_key_id": "vk-paos-worker" }
    ]
  }
}
