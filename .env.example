# Copy to .env, or let scripts/setup.sh / setup.ps1 create it.
# Keep .env private. Never commit it.

WEBUI_SECRET_KEY=GENERATE_ME
BIFROST_ENCRYPTION_KEY=GENERATE_ME

# Friendly private Tailscale names created by TSDProxy labels.
OPENWEBUI_TS_NAME=webui
BIFROST_TS_NAME=gateway

# Localhost-only bootstrap/admin ports.
TSDPROXY_LOCAL_PORT=8080
OPENWEBUI_LOCAL_PORT=3000
BIFROST_LOCAL_PORT=8081

# Pin these after validating a release for reproducibility.
OPENWEBUI_TAG=main
BIFROST_TAG=latest
# Keep TSDProxy on the stable v2 line; latest tracks 3.0.0-beta.
TSDPROXY_TAG=2.3.4

# Reserved for a future hardened setup using a Bifrost virtual key.
BIFROST_OPENWEBUI_KEY=not-required

# --- Optional dev container layer (compose.dev.yaml) ---
# Host directory mounted at /workspace in the devbox/mcp containers.
# Prefer a path OUTSIDE this repo so projects stay out of git.
# Example: DEV_WORKSPACE=$HOME/ai-workspace
DEV_WORKSPACE=./workspace

# Browser VS Code (code-server).
DEVBOX_LOCAL_PORT=8443
DEVBOX_TS_NAME=dev
DEVBOX_MEM_LIMIT=4g
DEVBOX_CPUS=2.0
CODE_SERVER_TAG=latest

# Agent tool bridge (mcpo). MCPO_API_KEY is required; generate a random value.
MCPO_LOCAL_PORT=8000
MCPO_API_KEY=GENERATE_ME
MCPO_TAG=main
MCP_MEM_LIMIT=2g
MCP_CPUS=2.0
