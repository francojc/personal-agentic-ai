# Fresh guest only: copy to .env, chmod 600, replace GENERATE_ME.
# Do not copy old workstation .env into new deployment.
BIFROST_TAG=v2.2.5
BIFROST_LOCAL_PORT=8081
BIFROST_ENCRYPTION_KEY=GENERATE_ME
BIFROST_ADMIN_USERNAME=paos-admin
BIFROST_ADMIN_PASSWORD=GENERATE_ME
# Provider keys go directly into Bifrost UI, not this file or Git.
